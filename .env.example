# Configuración del servidor
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Credenciales de Bancard/Infonet (solicitar al equipo)
BANCARD_PUBLIC_KEY=apps/your-public-key-here
BANCARD_PRIVATE_KEY=your-private-key-here

# URLs de la API externa (se configuran automáticamente según NODE_ENV)
# DEVELOPMENT: https://desa.infonet.com.py/epos-public-proxy/api
# PRODUCTION: https://comercios.bancard.com.py/epos-public-proxy/api